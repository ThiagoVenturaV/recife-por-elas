{
  "name": "projeto-base-backend",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "dev": "node --env-file=.env --watch dist/server.js",
    "test": "node --env-file-if-exists=.env --test tests/*.test.js",
    "test:e2e": "node --env-file-if-exists=.env --test tests-e2e/*.e2e.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "pg": "^8.13.1",
    "playwright-core": "^1.61.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.11.10",
    "typescript": "~6.0.2"
  }
}
